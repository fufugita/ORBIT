{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT",
  "version": "0.1.0",
  "identifier": "dev.orbit.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ORBIT",
